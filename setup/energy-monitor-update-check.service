[Unit]
Description=Check Emporia Energy Monitor deployed version against GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=energy
ExecStart=/usr/bin/python3 /usr/local/libexec/energy-monitor/check_server_updates.py
StateDirectory=energy-monitor-updates
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=90
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
